# Local IDE and out-of-source build trees
/cmake-build-*/
/.vscode/
/.idea/

# Generated diagnostics and compiler artifacts in the project root
/*.log
/*.stderr
/*.stdout
/*.err
/*.out
/*.obj
/*.ilk
/*.pdb
/*.dmp
/*.png

# Local fixtures and scratch files produced by smoke runs
/target.txt
/*.html
/*.txt

# Runtime asset cache (the application normally uses <build-dir>/cache)
/cache/
/resources/cache/
